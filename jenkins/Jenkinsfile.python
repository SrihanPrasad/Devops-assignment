// =============================================================================
// TASK 2 - Jenkins pipeline: Python app
//   Python build (wheel) -> unit test -> functional test -> performance test
//   -> Sonar scan -> Docker build -> push to Nexus & JFrog -> Argo CD deploy
//
// Job type : Pipeline -> "Pipeline script from SCM"
// Script Path: jenkins/Jenkinsfile.python
//
// Agent has:
//   - python3 (+ venv)
//   - Docker
//   - argocd CLI
//
// Jenkins:
//   - Global Tool "sonar-scanner"
//   - SonarQube server "sonarqube"
//
// Credentials:
//   - nexus-creds  : username/password
//   - jfrog-creds  : username/password
//   - argocd-token : secret text
// =============================================================================

pipeline {

    agent any

    options {
        timestamps()
        timeout(time: 45, unit: 'MINUTES')
        buildDiscarder(logRotator(numToKeepStr: '10'))
        disableConcurrentBuilds()
    }

    // =========================================================================
    // EDIT THESE FOR YOUR TRIAL INSTANCES
    // =========================================================================
    environment {

        // Python application
        APP_NAME          = 'demo-py-app'
        APP_DIR           = 'python-app'

        // Argo CD application base name
        // Actual apps:
        //   python-app-nexus
        //   python-app-jfrog
        ARGO_APP          = 'python-app'

        // Version generated from Jenkins build number
        VERSION           = "1.0.${BUILD_NUMBER}"

        // ---------------------------------------------------------------------
        // Nexus
        // ---------------------------------------------------------------------

        // Nexus PyPI hosted repository
        NEXUS_PYPI_URL    = 'http://172.31.21.234:8081/repository/pypi-hosted/'

        // Nexus Docker hosted repository
        NEXUS_DOCKER_HOST = '44.208.15.96:8082'

        // ---------------------------------------------------------------------
        // JFrog
        // ---------------------------------------------------------------------

        // JFrog Cloud trial instance
        JFROG_HOST        = 'trialmzbpgd.jfrog.io'

        // JFrog PyPI local repository
        JFROG_PYPI_URL    = 'https://trialmzbpgd.jfrog.io/artifactory/api/pypi/demo-pypi-local'

        // JFrog Docker local repository
        JFROG_DOCKER_REPO = 'demo-docker-local'

        // ---------------------------------------------------------------------
        // Argo CD
        // ---------------------------------------------------------------------

        ARGOCD_SERVER     = '192.168.49.2:32286'

        // Python virtual environment
        VENV              = "${WORKSPACE}/.venv"
    }

    // =========================================================================
    // PIPELINE STAGES
    // =========================================================================

    stages {

        // =====================================================================
        // 1. CHECKOUT
        // =====================================================================

        stage('Checkout') {

            steps {

                checkout scm

                sh '''
                    set -e

                    echo "======================================"
                    echo "Python version"
                    echo "======================================"

                    python3 --version

                    echo "======================================"
                    echo "Workspace"
                    echo "======================================"

                    pwd
                    ls -la
                '''
            }
        }

        // =====================================================================
        // 2. PYTHON BUILD - WHEEL
        // =====================================================================

        stage('Python Build (wheel)') {

            steps {

                dir(APP_DIR) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "Creating Python virtual environment"
                        echo "======================================"

                        python3 -m venv "$VENV"

                        . "$VENV/bin/activate"

                        echo "======================================"
                        echo "Upgrading pip and installing build tools"
                        echo "======================================"

                        pip install -q --upgrade pip
                        pip install -q build twine

                        echo "======================================"
                        echo "Installing project test dependencies"
                        echo "======================================"

                        pip install -q -e ".[test]"

                        echo "======================================"
                        echo "Setting application version"
                        echo "======================================"

                        sed -i "s/^version = .*/version = \\"$VERSION\\"/" pyproject.toml

                        echo "Version: $VERSION"

                        echo "======================================"
                        echo "Cleaning previous build files"
                        echo "======================================"

                        rm -rf dist build

                        echo "======================================"
                        echo "Building Python wheel"
                        echo "======================================"

                        python -m build --wheel

                        echo "======================================"
                        echo "Generated wheel"
                        echo "======================================"

                        ls -lh dist/
                    '''
                }
            }
        }

        // =====================================================================
        // 3. UNIT TESTS
        // =====================================================================

        stage('Unit Tests') {

            steps {

                dir(APP_DIR) {

                    sh '''
                        set -e

                        . "$VENV/bin/activate"

                        echo "======================================"
                        echo "Running unit tests"
                        echo "======================================"

                        pytest tests/unit -q \
                            --junitxml=junit-unit.xml \
                            --cov=app \
                            --cov-report=xml:coverage.xml \
                            --cov-report=term
                    '''
                }
            }

            post {

                always {

                    junit(
                        allowEmptyResults: true,
                        testResults: "${APP_DIR}/junit-unit.xml"
                    )
                }
            }
        }

        // =====================================================================
        // 4. FUNCTIONAL TESTS
        // =====================================================================

        stage('Functional Tests') {

            steps {

                dir(APP_DIR) {

                    sh '''
                        set -e

                        . "$VENV/bin/activate"

                        echo "======================================"
                        echo "Running functional tests"
                        echo "======================================"

                        pytest tests/functional -q \
                            --junitxml=junit-functional.xml
                    '''
                }
            }

            post {

                always {

                    junit(
                        allowEmptyResults: true,
                        testResults: "${APP_DIR}/junit-functional.xml"
                    )
                }
            }
        }

        // =====================================================================
        // 5. PERFORMANCE TEST
        // =====================================================================

        stage('Performance Tests') {

            steps {

                dir(APP_DIR) {

                    sh '''
                        set -e

                        . "$VENV/bin/activate"

                        echo "======================================"
                        echo "Starting application"
                        echo "======================================"

                        gunicorn \
                            -b 127.0.0.1:18000 \
                            app.wsgi:app &

                        APP_PID=$!

                        trap "kill $APP_PID 2>/dev/null || true" EXIT

                        echo "======================================"
                        echo "Waiting for application"
                        echo "======================================"

                        for i in $(seq 1 30); do

                            if curl -sf \
                                http://127.0.0.1:18000/health \
                                >/dev/null; then

                                echo "Application is ready"
                                break
                            fi

                            echo "Waiting for application... attempt $i"

                            sleep 1
                        done

                        echo "======================================"
                        echo "Running Locust performance test"
                        echo "======================================"

                        locust \
                            -f perf/locustfile.py \
                            --headless \
                            -u 10 \
                            -r 5 \
                            -t 30s \
                            --host http://127.0.0.1:18000 \
                            --csv perf/results \
                            --exit-code-on-error 1

                        echo "======================================"
                        echo "Performance test completed"
                        echo "======================================"
                    '''
                }
            }

            post {

                always {

                    archiveArtifacts(
                        artifacts: "${APP_DIR}/perf/results*.csv",
                        allowEmptyArchive: true
                    )
                }
            }
        }

        // =====================================================================
        // 6. SONARQUBE SCAN
        // =====================================================================

        stage('SonarQube Scan') {

            steps {

                dir(APP_DIR) {

                    script {

                        env.SCANNER_HOME = tool 'sonar-scanner'
                    }

                    withSonarQubeEnv('sonarqube') {

                        sh '''
                            set -e

                            echo "======================================"
                            echo "Running SonarQube scan"
                            echo "======================================"

                            "$SCANNER_HOME/bin/sonar-scanner" \
                                -Dsonar.projectVersion=$VERSION
                        '''
                    }
                }
            }
        }

        // =====================================================================
        // 7. QUALITY GATE
        // =====================================================================

        stage('Quality Gate') {

            steps {

                timeout(
                    time: 10,
                    unit: 'MINUTES'
                ) {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }

        // =====================================================================
        // 8. DOCKER BUILD
        // =====================================================================

        stage('Docker Build') {

            steps {

                dir(APP_DIR) {

                    sh '''
                        set -e

                        echo "======================================"
                        echo "Building Docker image"
                        echo "======================================"

                        docker build \
                            -t "$APP_NAME:$VERSION" \
                            .

                        echo "======================================"
                        echo "Docker image created"
                        echo "======================================"

                        docker images | grep "$APP_NAME" || true
                    '''
                }
            }
        }

        // =====================================================================
        // 9. PUBLISH ARTIFACTS
        // =====================================================================

        stage('Publish Artifacts') {

            parallel {

                // =============================================================
                // 9A. NEXUS
                // =============================================================

                stage('Push to Nexus') {

                    steps {

                        withCredentials([
                            usernamePassword(
                                credentialsId: 'nexus-creds',
                                usernameVariable: 'NEXUS_USER',
                                passwordVariable: 'NEXUS_PASSWORD'
                            )
                        ]) {

                            // -------------------------------------------------
                            // Upload Python wheel to Nexus PyPI
                            // -------------------------------------------------

                            dir(APP_DIR) {

                                sh '''
                                    set -e

                                    . "$VENV/bin/activate"

                                    echo "======================================"
                                    echo "Uploading wheel to Nexus PyPI"
                                    echo "======================================"

                                    TWINE_USERNAME="$NEXUS_USER" \
                                    TWINE_PASSWORD="$NEXUS_PASSWORD" \
                                    twine upload \
                                        --non-interactive \
                                        --repository-url "$NEXUS_PYPI_URL" \
                                        dist/*.whl
                                '''
                            }

                            // -------------------------------------------------
                            // Push Docker image to Nexus
                            // -------------------------------------------------

                            sh '''
                                set -e

                                echo "======================================"
                                echo "Logging in to Nexus Docker"
                                echo "======================================"

                                echo "$NEXUS_PASSWORD" | \
                                    docker login "$NEXUS_DOCKER_HOST" \
                                    -u "$NEXUS_USER" \
                                    --password-stdin

                                echo "======================================"
                                echo "Tagging Docker image"
                                echo "======================================"

                                docker tag \
                                    "$APP_NAME:$VERSION" \
                                    "$NEXUS_DOCKER_HOST/$APP_NAME:$VERSION"

                                echo "======================================"
                                echo "Pushing Docker image to Nexus"
                                echo "======================================"

                                docker push \
                                    "$NEXUS_DOCKER_HOST/$APP_NAME:$VERSION"

                                docker logout "$NEXUS_DOCKER_HOST"
                            '''
                        }
                    }
                }

                // =============================================================
                // 9B. JFROG
                // =============================================================

                stage('Push to JFrog') {

                    steps {

                        withCredentials([
                            usernamePassword(
                                credentialsId: 'jfrog-creds',
                                usernameVariable: 'JFROG_USER',
                                passwordVariable: 'JFROG_PASSWORD'
                            )
                        ]) {

                            // -------------------------------------------------
                            // Upload Python wheel to JFrog PyPI
                            // -------------------------------------------------

                            dir(APP_DIR) {

                                sh '''
                                    set -e

                                    . "$VENV/bin/activate"

                                    echo "======================================"
                                    echo "Uploading wheel to JFrog PyPI"
                                    echo "======================================"

                                    TWINE_USERNAME="$JFROG_USER" \
                                    TWINE_PASSWORD="$JFROG_PASSWORD" \
                                    twine upload \
                                        --non-interactive \
                                        --repository-url "$JFROG_PYPI_URL" \
                                        dist/*.whl
                                '''
                            }

                            // -------------------------------------------------
                            // Push Docker image to JFrog
                            // -------------------------------------------------

                            sh '''
                                set -e

                                echo "======================================"
                                echo "Logging in to JFrog Docker"
                                echo "======================================"

                                echo "$JFROG_PASSWORD" | \
                                    docker login "$JFROG_HOST" \
                                    -u "$JFROG_USER" \
                                    --password-stdin

                                echo "======================================"
                                echo "Tagging Docker image"
                                echo "======================================"

                                docker tag \
                                    "$APP_NAME:$VERSION" \
                                    "$JFROG_HOST/$JFROG_DOCKER_REPO/$APP_NAME:$VERSION"

                                echo "======================================"
                                echo "Pushing Docker image to JFrog"
                                echo "======================================"

                                docker push \
                                    "$JFROG_HOST/$JFROG_DOCKER_REPO/$APP_NAME:$VERSION"

                                docker logout "$JFROG_HOST"
                            '''
                        }
                    }
                }
            }
        }

        // =====================================================================
        // 10. DEPLOY THROUGH ARGO CD
        //
        // IMPORTANT:
        // We use:
        //   argocd app set
        //   argocd app wait --sync --health
        //
        // We do NOT use:
        //   argocd app sync
        //   argocd app get
        //
        // This avoids the previous Argo CD operation-in-progress and
        // permission problems.
        // =====================================================================

        stage('Deploy via Argo CD') {

            parallel {

                // =============================================================
                // 10A. NEXUS -> ARGO CD
                // =============================================================

                stage('Nexus image -> Argo CD') {

                    steps {

                        withCredentials([
                            string(
                                credentialsId: 'argocd-token',
                                variable: 'ARGOCD_AUTH_TOKEN'
                            )
                        ]) {

                            sh '''
                                set -e

                                export ARGOCD_SERVER
                                export ARGOCD_AUTH_TOKEN

                                APP=${ARGO_APP}-nexus

                                IMAGE=$NEXUS_DOCKER_HOST/$APP_NAME:$VERSION

                                echo "======================================"
                                echo "Deploying Nexus image"
                                echo "======================================"

                                echo "Argo Application : $APP"
                                echo "Image            : $IMAGE"

                                echo "======================================"
                                echo "Updating Argo CD application"
                                echo "======================================"

                                argocd app set "$APP" \
                                    --grpc-web \
                                    --insecure \
                                    --kustomize-image "${ARGO_APP}=$IMAGE"

                                echo "======================================"
                                echo "Waiting for Argo CD deployment"
                                echo "======================================"

                                argocd app wait "$APP" \
                                    --grpc-web \
                                    --insecure \
                                    --sync \
                                    --health \
                                    --timeout 300

                                echo "======================================"
                                echo "Nexus Argo CD deployment completed"
                                echo "======================================"
                            '''
                        }
                    }
                }

                // =============================================================
                // 10B. JFROG -> ARGO CD
                // =============================================================

                stage('JFrog image -> Argo CD') {

                    steps {

                        withCredentials([
                            string(
                                credentialsId: 'argocd-token',
                                variable: 'ARGOCD_AUTH_TOKEN'
                            )
                        ]) {

                            sh '''
                                set -e

                                export ARGOCD_SERVER
                                export ARGOCD_AUTH_TOKEN

                                APP=${ARGO_APP}-jfrog

                                IMAGE=$JFROG_HOST/$JFROG_DOCKER_REPO/$APP_NAME:$VERSION

                                echo "======================================"
                                echo "Deploying JFrog image"
                                echo "======================================"

                                echo "Argo Application : $APP"
                                echo "Image            : $IMAGE"

                                echo "======================================"
                                echo "Updating Argo CD application"
                                echo "======================================"

                                argocd app set "$APP" \
                                    --grpc-web \
                                    --insecure \
                                    --kustomize-image "${ARGO_APP}=$IMAGE"

                                echo "======================================"
                                echo "Waiting for Argo CD deployment"
                                echo "======================================"

                                argocd app wait "$APP" \
                                    --grpc-web \
                                    --insecure \
                                    --sync \
                                    --health \
                                    --timeout 300

                                echo "======================================"
                                echo "JFrog Argo CD deployment completed"
                                echo "======================================"
                            '''
                        }
                    }
                }
            }
        }
    }

    // =========================================================================
    // POST ACTIONS
    // =========================================================================

    post {

        success {

            echo "============================================================"
            echo "PIPELINE SUCCESS"
            echo "============================================================"

            echo "Application : ${APP_NAME}"
            echo "Version     : ${VERSION}"
            echo "Nexus image : ${NEXUS_DOCKER_HOST}/${APP_NAME}:${VERSION}"
            echo "JFrog image : ${JFROG_HOST}/${JFROG_DOCKER_REPO}/${APP_NAME}:${VERSION}"

            echo "============================================================"
        }

        failure {

            echo "============================================================"
            echo "PIPELINE FAILED"
            echo "============================================================"

            echo "Check the failing stage log above."

            echo "============================================================"
        }

        always {

            cleanWs(
                deleteDirs: true,
                notFailBuild: true
            )
        }
    }
}
