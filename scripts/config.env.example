# Copy to scripts/config.env and fill in. config.env is git-ignored. Never commit real secrets.

APP_NAME=demo-app

# --- SonarQube (trial / community) ---
SONAR_HOST_URL=http://localhost:9000
SONAR_ADMIN_TOKEN=            # user token; used only to mint the 24h project-scoped token
SONAR_PROJECT_KEY=demo-app

# --- Nexus ---
NEXUS_MAVEN_URL=http://localhost:8081/repository/maven-releases/
NEXUS_DOCKER_HOST=localhost:8082
NEXUS_USER=admin
NEXUS_PASSWORD=

# --- JFrog Cloud trial ---
JFROG_HOST=YOURTRIAL.jfrog.io
JFROG_MAVEN_URL=https://YOURTRIAL.jfrog.io/artifactory/demo-maven-local
JFROG_DOCKER_REPO=demo-docker-local
JFROG_USER=you@example.com
JFROG_PASSWORD=               # identity token recommended

# --- Kubernetes (kubectl must already point at your cluster) ---
NS_NEXUS=demo-nexus
NS_JFROG=demo-jfrog
