provider "aws" {
  region = var.region

  default_tags {
    tags = local.tags
  }
}

locals {
  name = "${var.project}-${var.environment}"

  # Requirement 4/8: instance type chosen from the environment variable.
  instance_type = var.environment == "prod" ? "t3.medium" : "t2.micro"

  tags = {
    Project     = var.project
    Environment = var.environment
    ManagedBy   = "terraform"
  }
}

# Requirement 7: fetch an existing AMI dynamically (latest Amazon Linux 2023, x86_64).
data "aws_ami" "al2023" {
  most_recent = true
  owners      = ["amazon"]

  filter {
    name   = "name"
    values = ["al2023-ami-2023.*-x86_64"]
  }

  filter {
    name   = "virtualization-type"
    values = ["hvm"]
  }

  filter {
    name   = "architecture"
    values = ["x86_64"]
  }
}

# SSH key pair generated by Terraform so the provisioner can log in.
# NOTE: the private key ends up in the state file - fine here because the state bucket
# is private + encrypted, but use a pre-existing key / SSM Session Manager in real prod.
resource "tls_private_key" "ssh" {
  algorithm = "RSA"
  rsa_bits  = 4096
}

resource "aws_key_pair" "ssh" {
  key_name   = "${local.name}-key"
  public_key = tls_private_key.ssh.public_key_openssh
}

resource "local_sensitive_file" "ssh_private_key" {
  content         = tls_private_key.ssh.private_key_pem
  filename        = "${path.module}/${local.name}-key.pem"
  file_permission = "0400"
}

# ---------------------------------------------------------------------------- modules
module "vpc" {
  source = "./modules/vpc"

  name                = local.name
  vpc_cidr            = var.vpc_cidr
  public_subnet_cidrs = var.public_subnet_cidrs
}

module "security_groups" {
  source = "./modules/security_groups"

  name     = local.name
  vpc_id   = module.vpc.vpc_id
  ssh_cidr = var.ssh_cidr
}

module "autoscaling" {
  source = "./modules/autoscaling"

  name             = local.name
  environment      = var.environment
  ami_id           = data.aws_ami.al2023.id
  instance_type    = local.instance_type
  key_name         = aws_key_pair.ssh.key_name
  private_key_pem  = tls_private_key.ssh.private_key_pem
  vpc_id           = module.vpc.vpc_id
  subnet_ids       = module.vpc.public_subnet_ids
  alb_sg_id        = module.security_groups.alb_sg_id
  web_sg_id        = module.security_groups.web_sg_id
  min_size         = var.desired_capacity
  desired_capacity = var.desired_capacity
  max_size         = var.desired_capacity + 2
}
